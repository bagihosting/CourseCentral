GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# Database connection details for local development
# Used by Next.js when running with `npm run dev`
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="coursecentral_db"

# Public URL of the application, required for sitemap and SEO.
# Do not include a trailing slash.
# Example for production: https://www.yourdomain.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ===================================================================
# DOCKER-SPECIFIC VARIABLES
# These are used by docker-compose.yml. 
# You only need to create a `.env` file from this example when
# deploying with Docker (Method 2 in DEPLOYMENT.md).
# ===================================================================

# Strong password for the MariaDB root user inside Docker
MARIADB_ROOT_PASSWORD="ganti_dengan_password_root_yang_aman"

# Database name for the app inside Docker
MARIADB_DATABASE="coursecentral_db"

# Database user for the app inside Docker
MARIADB_USER="coursecentral_user"

# Strong password for the app's database user inside Docker
MARIADB_PASSWORD="ganti_dengan_password_db_yang_aman"
