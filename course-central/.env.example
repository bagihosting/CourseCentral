# Kunci API untuk Google AI (Gemini). Wajib diisi.
GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# ==========================================================
# Variabel Lingkungan untuk Docker (digunakan oleh docker-compose.yml)
# Ganti semua nilai placeholder di bawah ini.
# ==========================================================
MARIADB_ROOT_PASSWORD="ganti_dengan_password_root_yang_kuat"
MARIADB_DATABASE="coursecentral_db"
MARIADB_USER="coursecentral_user"
MARIADB_PASSWORD="ganti_dengan_password_user_yang_kuat"


# ==========================================================
# Variabel Lingkungan untuk Development Lokal (file .env.local)
# Cukup salin dan sesuaikan bagian ini ke dalam .env.local Anda.
# ==========================================================
# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_USER="root"
# DB_PASSWORD=""
# DB_NAME="coursecentral_db"
