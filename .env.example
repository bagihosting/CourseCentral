# Kunci API untuk layanan Google AI Studio / Gemini
GEMINI_API_KEY="PASTE_YOUR_GEMINI_API_KEY_HERE"

# ==============================================================
#      Variabel Lingkungan untuk Docker Compose (docker-compose.yml)
# ==============================================================
# Anda HARUS mengisi semua variabel di bawah ini sebelum menjalankan `docker-compose up`.
# Ini adalah kredensial untuk database MariaDB yang akan dibuat oleh Docker.
# Gunakan password yang kuat dan acak untuk produksi.

# Password untuk pengguna 'root' database MariaDB.
MARIADB_ROOT_PASSWORD="ganti_dengan_password_root_yang_kuat"

# Nama database yang akan dibuat untuk aplikasi.
MARIADB_DATABASE="coursecentral_db"

# Username untuk aplikasi mengakses database.
MARIADB_USER="coursecentral_user"

# Password untuk pengguna aplikasi di atas.
MARIADB_PASSWORD="ganti_dengan_password_user_yang_kuat"
